{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": { "title": "Pol's Kurumsal (taslak)", "description": "Pol's kurumsal tek sayfa sitesi, WordPress blok teması. TR + EN.", "author": "Pol's" },
  "landingPage": "/",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "login": true,
  "steps": [
    { "step": "setSiteOptions", "options": { "blogname": "Pol's", "blogdescription": "İyi gıda herkesin hakkı", "permalink_structure": "/%postname%/", "timezone_string": "Europe/Istanbul" } },
    { "step": "installPlugin", "pluginData": { "resource": "wordpress.org/plugins", "slug": "polylang" }, "options": { "activate": true } },
    { "step": "installTheme", "themeData": { "resource": "url", "url": "https://raw.githubusercontent.com/GITHUB_KULLANICI/pols-kurumsal/main/pols-kurumsal.zip" }, "options": { "activate": true } },
    { "step": "runPHP", "code": "<?php define('WP_ADMIN', true); require_once '/wordpress/wp-load.php'; require_once ABSPATH . 'wp-admin/includes/admin.php'; wp_set_current_user(1); pols_run_setup();" },
    { "step": "runPHP", "code": "<?php require_once '/wordpress/wp-load.php'; flush_rewrite_rules(false);" }
  ]
}
